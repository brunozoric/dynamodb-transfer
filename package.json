    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format:fix": "oxfmt 'src/**/*.{ts,js}' 'extensions/**/*.{ts,js}' '__tests__/**/*.ts' 'vitest.config.ts' '.adiorc.js' 'setup-yarnrc.js' 'tsconfig.json' 'config.**'",
    "format:check": "oxfmt --check",
    "full": "yarn ts-check && yarn format:fix && yarn lint:fix && yarn test:coverage"
  },
  "dependencies": {
