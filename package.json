    "@inquirer/prompts": "^8.7.5",
    "@webiny/di": "^2.0.0",
    "dotenv": "^18.0.9",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@smithy/node-http-handler": "^4.14.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "adio": "^3.0.1",
